<service>

  <id>Caddy</id>
  <name>Caddy Reverse Proxy</name>
  <description>rorcun.com ve kitap.rorcun.com icin Caddy HTTPS ters vekil sunucusu (proje: LocalAgentApi-WebU). Sistem acilista otomatik baslar.</description>

  <executable>C:\Project\LocalAgentApi-WebU - OpenCode\caddy\caddy.exe</executable>
  <arguments>run --config "C:\Project\LocalAgentApi-WebU - OpenCode\caddy\Caddyfile"</arguments>
  <workingdirectory>C:\Project\LocalAgentApi-WebU - OpenCode\caddy</workingdirectory>

  <startmode>Automatic</startmode>
  <delayedautostart>false</delayedautostart>

  <!-- Cokme halinde artan bekleme sureleriyle yeniden baslat -->
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>

  <stoptimeout>15 sec</stoptimeout>

  <log mode="roll-by-size">
    <logPath>C:\Project\LocalAgentApi-WebU - OpenCode\caddy\logs</logPath>
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

</service>
