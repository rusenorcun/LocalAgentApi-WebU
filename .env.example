# LocalAgent Docker Ortam Değişkenleri (.env.example)
#
# Kalıcı JWT gizli anahtarı üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=degistir_uzun_rastgele_anahtar

# Ağ ve Port
PORT=9000
HOST=0.0.0.0
COOKIE_SECURE=true

# Ollama Sunucusu:
# Ollama ana makinede (Windows) GPU üzerinde çalışır.
# Docker konteynerinden ana makineye erişim için host.docker.internal kullanılır.
OLLAMA_HOST=http://host.docker.internal:11434

# Modeller
MODEL_NAME=qwen3.6:35b-a3b-q4_K_M
NUM_CTX=8192
MAX_CHAT_TOKENS=250000

# Görsel -> Metin (Caption) Hattı
IMAGE_TO_TEXT=true
CAPTION_MODEL=qwen3-vl:8b

# Kullanıcı Kaydı
ALLOW_REGISTRATION=false
